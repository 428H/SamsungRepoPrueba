@{
    ViewData["Title"] = "Historial de Precios";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-3 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #212529;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0"><i class="fa-solid fa-clock-rotate-left me-2"></i>HISTORIAL DE CAMBIOS DE PRECIO</h4>
                    <p class="text-white-50 mb-0 small">Registro de modificaciones en los precios de productos</p>
                </div>
            </div>
        </div>
    </div>

    <table id="tblHistorialPrecios" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Precio Anterior</th>
                <th>Precio Nuevo</th>
                <th>Fecha Cambio</th>
                <th>Motivo</th>
                <th>Usuario</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/historialPrecios.js"></script>
}