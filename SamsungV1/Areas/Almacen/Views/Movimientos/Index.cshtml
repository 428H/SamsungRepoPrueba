@{
    ViewData["Title"] = "Movimientos de Inventario";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-3 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #212529;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0"><i class="fa-solid fa-exchange-alt me-2"></i>MOVIMIENTOS DE INVENTARIO</h4>
                    <p class="text-white-50 mb-0 small">Historial de movimientos de productos en inventario</p>
                </div>
            </div>
        </div>
        <div class="card-body">
            <table id="tblMovimientos" class="table table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Tipo</th>
                        <th>Fecha</th>
                        <th>Motivo</th>
                        
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/movimientos.js"></script>
}