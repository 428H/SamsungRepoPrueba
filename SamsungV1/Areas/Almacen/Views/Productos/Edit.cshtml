@model Sistema.Models.ViewModels.ProductoVM

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="text-center mb-0"><i class="fa-solid fa-edit me-2"></i>Editar Producto</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-8">
                                <!-- Campo oculto para el ID del producto -->
                                <input type="hidden" asp-for="Producto.id_producto" />

                                <!-- Información Básica -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información Básica</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="Producto.modelo" class="form-label fw-bold">Modelo</label>
                                            <input asp-for="Producto.modelo" class="form-control" placeholder="Modelo del producto" />
                                            <span asp-validation-for="Producto.modelo" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Producto.nombre" class="form-label fw-bold">Nombre</label>
                                            <input asp-for="Producto.nombre" class="form-control" placeholder="Nombre del producto" />
                                            <span asp-validation-for="Producto.nombre" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Producto.descripcion" class="form-label fw-bold">Descripción</label>
                                            <textarea asp-for="Producto.descripcion" class="form-control" style="height: 150px;"></textarea>
                                            <span asp-validation-for="Producto.descripcion" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Especificaciones -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Especificaciones Técnicas</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="especMemoria" class="form-label">Memoria</label>
                                                <input type="text" id="especMemoria" class="form-control" placeholder="Ej: 8GB, 16GB">
                                            </div>
                                            <div class="col-md-6">
                                                <label for="especCamara" class="form-label">Cámara</label>
                                                <input type="text" id="especCamara" class="form-control" placeholder="Ej: 48MP, Dual 12MP+8MP">
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="especPantalla" class="form-label">Pantalla</label>
                                                <input type="text" id="especPantalla" class="form-control" placeholder="Ej: 6.5 pulgadas, AMOLED">
                                            </div>
                                            <div class="col-md-6">
                                                <label for="especColor" class="form-label">Color</label>
                                                <input type="text" id="especColor" class="form-control" placeholder="Ej: Negro, Azul, Blanco">
                                            </div>
                                        </div>
                                        <input type="hidden" asp-for="Producto.especificaciones" id="especificacionesJson" />
                                        <small class="form-text text-muted mt-2">Actualice los campos de especificaciones según sea necesario.</small>
                                        <span asp-validation-for="Producto.especificaciones" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Información Comercial -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Información Comercial</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label asp-for="Producto.precio" class="form-label fw-bold">Precio</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input asp-for="Producto.precio" class="form-control" placeholder="0.00" />
                                                </div>
                                                <span asp-validation-for="Producto.precio" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="Producto.costo" class="form-label fw-bold">Costo</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input asp-for="Producto.costo" class="form-control" placeholder="0.00" />
                                                </div>
                                                <span asp-validation-for="Producto.costo" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Categoría</label>
                                            @Html.DropDownListFor(m => m.Producto.id_categoria, Model.ListaCategorias,
                                                     "Seleccione una categoría", new { @class = "form-select" })
                                            <span asp-validation-for="Producto.id_categoria" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Presentación y Estado -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-image me-2"></i>Presentación y Estado</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="Producto.ruta_imagen" class="form-label fw-bold">Imagen del Producto</label>
                                            <input type="file" name="archivos" id="subidaArchivo" class="form-control" />
                                            <small class="text-muted">Seleccione una nueva imagen para reemplazar la actual (opcional)</small>
                                            <span asp-validation-for="Producto.ruta_imagen" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Producto.estado" class="form-label fw-bold">Estado</label>
                                            <select asp-for="Producto.estado" class="form-select">
                                                <option value="activo">Activo</option>
                                                <option value="inactivo">Inactivo</option>
                                            </select>
                                            <span asp-validation-for="Producto.estado" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Campos ocultos -->
                                <input type="hidden" asp-for="Producto.fecha_creacion" />
                                <input type="hidden" asp-for="Producto.id_usuario" />

                                <!-- Botones de acción -->
                                <div class="d-flex justify-content-between mt-4">
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fa-solid fa-arrow-left me-1"></i> Volver
                                    </a>
                                    <button type="submit" class="btn btn-dark">
                                        <i class="fa-solid fa-save me-1"></i> Actualizar Producto
                                    </button>
                                </div>
                            </div>

                            <!-- Panel lateral con la imagen actual e información -->
                            <div class="col-md-4">
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-eye me-2"></i>Imagen Actual</h5>
                                    </div>
                                    <div class="card-body text-center">
                                        @if (!string.IsNullOrEmpty(Model.Producto.ruta_imagen))
                                        {
                                            <img src="/@Model.Producto.ruta_imagen" class="img-fluid rounded mb-3" style="max-height: 300px; border: 1px solid #dee2e6;" />
                                            <input type="hidden" asp-for="Producto.ruta_imagen" />
                                            <p class="text-muted small">Imagen actual del producto</p>
                                        }
                                        else
                                        {
                                            <div class="p-5 bg-light rounded mb-3 d-flex align-items-center justify-content-center" style="height: 200px;">
                                                <div class="text-center text-muted">
                                                    <i class="fas fa-image fa-4x mb-3"></i>
                                                    <p>No hay imagen disponible</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <!-- NUEVA SECCIÓN: Información de Inventario -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>Información de Inventario</h5>
                                    </div>
                                    <div class="card-body">
                                        @if (Model.InventarioActual != null && Model.InventarioActual.id_inventario > 0)
                                        {
                                            <!-- Campos ocultos para el inventario -->
                                            <input type="hidden" asp-for="InventarioActual.id_inventario" />
                                            <input type="hidden" asp-for="InventarioActual.id_producto" />
                                            <input type="hidden" asp-for="InventarioActual.cantidad_disponible" />
                                            <input type="hidden" asp-for="InventarioActual.ultima_actualizacion" />

                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Stock Actual</label>
                                                <div class="input-group">
                                                    <input value="@Model.InventarioActual.cantidad_disponible" class="form-control" readonly />
                                                    <span class="input-group-text">unidades</span>
                                                </div>
                                                <small class="text-muted">Para modificar el stock, use la opción "Gestionar Stock"</small>
                                            </div>

                                            <div class="mb-3">
                                                <label asp-for="InventarioActual.stock_minimo" class="form-label fw-bold">Stock Mínimo</label>
                                                <div class="input-group">
                                                    <input asp-for="InventarioActual.stock_minimo" class="form-control" type="number" min="1" step="1" />
                                                    <span class="input-group-text">unidades</span>
                                                </div>
                                                <small class="text-muted">Cantidad mínima antes de reabastecimiento</small>
                                                <span asp-validation-for="InventarioActual.stock_minimo" class="text-danger"></span>
                                            </div>

                                            @if (Model.InventarioActual.cantidad_disponible <= Model.InventarioActual.stock_minimo)
                                            {
                                                <div class="alert alert-warning mt-3 py-2 small">
                                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                                    <strong>Alerta:</strong> El stock actual está por debajo del mínimo.
                                                </div>
                                            }

                                            <a asp-action="AgregarProducto" asp-route-id="@Model.Producto.id_producto" class="btn btn-info btn-sm w-100 mt-2">
                                                <i class="fas fa-plus-circle me-1"></i> Gestionar Stock
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="text-center p-3">
                                                <i class="fas fa-exclamation-circle fa-3x text-muted mb-3"></i>
                                                <p>No hay información de inventario para este producto.</p>
                                                <a asp-action="AgregarProducto" asp-route-id="@Model.Producto.id_producto" class="btn btn-primary btn-sm">
                                                    <i class="fas fa-plus-circle me-1"></i> Añadir Inventario
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <!-- Consejos para edición -->
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Consejos para edición</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-pen text-dark me-2"></i>Actualización de datos</h6>
                                            <ul class="small ps-3">
                                                <li>Actualice solo la información que necesita cambiar</li>
                                                <li>No es necesario subir una nueva imagen si desea mantener la actual</li>
                                                <li>Revise cuidadosamente antes de guardar</li>
                                            </ul>
                                        </div>

                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-exclamation-triangle text-warning me-2"></i>Importante</h6>
                                            <ul class="small ps-3">
                                                <li>Si sube una nueva imagen, la anterior será reemplazada</li>
                                                
                                            </ul>
                                        </div>

                                        <div class="alert alert-info small">
                                            <i class="fas fa-lightbulb me-2"></i>
                                            Mantenga toda la información actualizada para mejorar la visibilidad del producto.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.3/tinymce.min.js"
            integrity="sha512-VCEWnpOl7PIhbYMcb64pqGZYez41C2uws/M/mDdGPy+vtEJHd9BqbShE4/VNnnZdr7YCPOjd+CBmYca/7WWWCw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        tinymce.init({
            selector: 'textarea',
            plugins:'lists advlist link image',
            menubar: 'file edit format',
            toolbar: 'undo redo | formatselect | bold italic | bullist numlist | link image'
        });
    </script>

    <script src="~/js/productoEspecificacione.js"></script>
}