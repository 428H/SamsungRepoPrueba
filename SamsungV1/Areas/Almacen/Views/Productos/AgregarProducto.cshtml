@model Sistema.Models.ViewModels.ProductoVM
@{
    ViewData["Title"] = "Gestionar Stock";
}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="text-center mb-0"><i class="fa-solid fa-boxes me-2"></i>Gestionar Stock del Producto</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="AgregarProducto">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Campo oculto para el ID del producto -->
                        <input type="hidden" name="id" value="@Model.Producto.id_producto" />

                        <!-- Información básica del producto -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información del Producto</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Nombre del Producto</label>
                                        <input class="form-control" value="@Model.Producto.nombre" readonly />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Modelo</label>
                                        <input class="form-control" value="@Model.Producto.modelo" readonly />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Precio</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input class="form-control" value="@Model.Producto.precio.ToString("0.00")" readonly />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Stock Actual</label>
                                        <input class="form-control fw-bold text-center" value="@Model.InventarioActual.cantidad_disponible unidades" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                       
                        <!-- Gestión de Stock -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="fas fa-exchange-alt me-2"></i>Modificar Stock</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Tipo de Operación</label>
                                    <select name="tipoOperacion" class="form-control" required>
                                        <option value="agregar">Agregar Stock</option>
                                        <option value="reducir">Reducir Stock</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Cantidad</label>
                                    <input type="number" name="cantidad" class="form-control" min="1" required placeholder="Ingrese la cantidad" />
                                    <small class="text-muted">Número de unidades para agregar o reducir del inventario</small>
                                </div>

                                <!-- Tipo de Movimiento -->
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Tipo de Movimiento</label>
                                    <select name="id_tipo_movimiento" class="form-select" required>
                                        <option value="">Seleccione un tipo de movimiento</option>
                                        @foreach (var item in Model.ListaTiposMovimiento)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                    <small class="text-muted">Clasifique el tipo de movimiento de inventario</small>
                                </div>

                                <!-- Motivo del Movimiento -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Motivo del Movimiento</label>
                                    <textarea name="motivo" class="form-control" rows="3"></textarea>
                                    <small class="text-muted">Opcional: Detalles o justificación para este cambio de inventario</small>
                                </div>

                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Nota:</strong> Al reducir stock, tenga en cuenta que no puede quedar con stock negativo.
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-dark">
                                <i class="fa-solid fa-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>