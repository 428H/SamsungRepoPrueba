<div class="container mt-4">
    <div class="card shadow border-0 rounded-3 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #212529;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0"><i class="fa-solid fa-mobile-screen-button me-2"></i>LISTA PRODUCTOS</h4>
                    <p class="text-white-50 mb-0 small">Administre los productos</p>
                </div>
                <div>
                    <a asp-action="Create" class="text-black bg-body-tertiary btn btn-success">
                        <i class="fa-solid fa-plus me-1"></i> Ingresar Producto 
                    </a>
                </div>
            </div>
        </div>
    </div>
    <table id="tblProductos" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Especificaciones</th>
                <th>Imagen</th>
                <th>Acciones</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/productos.js"></script>
}