@model Sistema.Models.ViewModels.ProductoVM

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="text-center mb-0"><i class="fa-solid fa-mobile-alt me-2"></i>Ingresar Nuevo Producto</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-8">
                                <!-- Información Básica -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información Básica</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="Producto.modelo" class="form-label fw-bold">Modelo</label>
                                            <input asp-for="Producto.modelo" class="form-control" placeholder="Modelo del producto" />
                                            <span asp-validation-for="Producto.modelo" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Producto.nombre" class="form-label fw-bold">Nombre</label>
                                            <input asp-for="Producto.nombre" class="form-control" placeholder="Nombre del producto" />
                                            <span asp-validation-for="Producto.nombre" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Producto.descripcion" class="form-label fw-bold">Descripción</label>
                                            <textarea asp-for="Producto.descripcion" class="form-control" style="height: 150px;"></textarea>
                                            <span asp-validation-for="Producto.descripcion" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Especificaciones -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Especificaciones Técnicas</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label for="especMemoria" class="form-label">Memoria</label>
                                                <input type="text" id="especMemoria" class="form-control" placeholder="Ej: 8GB, 16GB">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="especCamara" class="form-label">Cámara</label>
                                                <input type="text" id="especCamara" class="form-control" placeholder="Ej: 48MP, Dual 12MP+8MP">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="especColor" class="form-label">Color</label>
                                                <input type="text" id="especColor" class="form-control" placeholder="Ej: Negro, Azul, Blanco">
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label for="especPantalla" class="form-label">Pantalla</label>
                                            <input type="text" id="especPantalla" class="form-control" placeholder="Ej: 6.5 pulgadas, AMOLED">
                                        </div>
                                        <input type="hidden" asp-for="Producto.especificaciones" id="especificacionesJson" />
                                        <small class="form-text text-muted mt-2">Complete los campos de especificaciones según corresponda.</small>
                                        <span asp-validation-for="Producto.especificaciones" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Información Comercial -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Información Comercial</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label asp-for="Producto.precio" class="form-label fw-bold">Precio</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input asp-for="Producto.precio" class="form-control" placeholder="0.00" />
                                                </div>
                                                <span asp-validation-for="Producto.precio" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="Producto.costo" class="form-label fw-bold">Costo</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input asp-for="Producto.costo" class="form-control" placeholder="0.00" />
                                                </div>
                                                <span asp-validation-for="Producto.costo" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Categoría</label>
                                            @Html.DropDownListFor(m => m.Producto.id_categoria, Model.ListaCategorias,
                                                     "Seleccione una categoría", new { @class = "form-select" })
                                            <span asp-validation-for="Producto.id_categoria" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <!-- Información de Inventario -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>Información de Inventario</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label asp-for="InventarioActual.cantidad_disponible" class="form-label fw-bold">Cantidad Inicial</label>
                                                <input asp-for="InventarioActual.cantidad_disponible" class="form-control" placeholder="0" type="number" min="1" step="1" />
                                                <span asp-validation-for="InventarioActual.cantidad_disponible" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="InventarioActual.stock_minimo" class="form-label fw-bold">Stock Mínimo</label>
                                                <input asp-for="InventarioActual.stock_minimo" class="form-control" placeholder="0" type="number" min="1" step="1" />
                                                <span asp-validation-for="InventarioActual.stock_minimo" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <!-- Tipo de Movimiento para la Creación Inicial -->
                                        <div class="mb-3">
                                            <label asp-for="MovimientoInventario.id_tipo_movimiento" class="form-label fw-bold">Tipo de Movimiento Inicial</label>
                                            <select asp-for="MovimientoInventario.id_tipo_movimiento" class="form-select">
                                                <option value="">Seleccione un tipo de movimiento</option>
                                                @foreach (var item in Model.ListaTiposMovimiento)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            </select>
                                            <span asp-validation-for="MovimientoInventario.id_tipo_movimiento" class="text-danger"></span>
                                        </div>

                                        <div class="alert alert-info small">
                                            <i class="fas fa-info-circle me-2"></i>
                                            Establezca la cantidad inicial y el stock mínimo para gestionar el inventario del producto.
                                            El sistema alertará cuando el stock esté por debajo del mínimo establecido.
                                        </div>
                                    </div>
                                </div>
                                <!-- Presentación y Estado -->
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-image me-2"></i>Presentación y Estado</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="Producto.ruta_imagen" class="form-label fw-bold">Imagen del Producto</label>
                                            <input type="file" name="archivos" id="subidaArchivo" class="form-control" />
                                            <small class="text-muted">Seleccione una imagen para el producto (formato recomendado: JPG, PNG)</small>
                                            <span asp-validation-for="Producto.ruta_imagen" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Producto.estado" class="form-label fw-bold">Estado</label>
                                            <select asp-for="Producto.estado" class="form-select">
                                                <option value="activo">Activo</option>
                                                <option value="inactivo">Inactivo</option>
                                            </select>
                                            <span asp-validation-for="Producto.estado" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Campos ocultos -->
                                <input type="hidden" asp-for="Producto.fecha_creacion" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" />
                                <input type="hidden" asp-for="Producto.id_usuario" value="@User.Identity.Name" />

                                <!-- Botones -->
                                <div class="d-flex justify-content-between mt-4">
                                    <partial name="_VistaCrearVolver" />
                                </div>
                                @* <div class="d-flex justify-content-between mt-4">
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fa-solid fa-arrow-left me-1"></i> Volver
                                    </a>
                                    <button type="submit" class="btn btn-dark">
                                        <i class="fa-solid fa-save me-1"></i> Guardar Producto
                                    </button>
                                </div> *@
                            </div>

                            <!-- Panel de consejos -->
                            <div class="col-md-4">
                                <div class="card sticky-top" style="top: 20px;">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Consejos útiles</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-lightbulb text-warning me-2"></i>Información básica</h6>
                                            <ul class="small ps-3">
                                                <li>Use un nombre claro y descriptivo</li>
                                                <li>Incluya el modelo exacto del producto</li>
                                                <li>La descripción debe ser detallada</li>
                                            </ul>
                                        </div>

                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-cogs text-dark me-2"></i>Especificaciones</h6>
                                            <ul class="small ps-3">
                                                <li>Mencione todas las características técnicas</li>
                                                <li>Sea exacto con las especificaciones</li>
                                                <li>Incluya tamaño, peso y medidas</li>
                                            </ul>
                                        </div>

                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-image text-primary me-2"></i>Imagen</h6>
                                            <ul class="small ps-3">
                                                <li>Use imágenes de alta calidad</li>
                                                <li>La imagen debe mostrar claramente el producto</li>
                                                <li>Fondo blanco o neutro es recomendable</li>
                                            </ul>
                                        </div>

                                        <div class="alert alert-info small">
                                            <i class="fas fa-exclamation-circle me-2"></i>
                                            Complete todos los campos para que su producto sea más visible en las búsquedas de los clientes.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.3/tinymce.min.js"
            integrity="sha512-VCEWnpOl7PIhbYMcb64pqGZYez41C2uws/M/mDdGPy+vtEJHd9BqbShE4/VNnnZdr7YCPOjd+CBmYca/7WWWCw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        tinymce.init({
            selector: 'textarea',
            plugins:'lists advlist link image',
            menubar: 'file edit format',
            toolbar: 'undo redo | formatselect | bold italic | bullist numlist | link image'
        });
    </script>

    <script src="~/js/productoEspecificacione.js"></script>
}