@model Sistema.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoría";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="text-center mb-0"><i class="fa-solid fa-pencil me-2"></i>Editar Categoría</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-8">
                                <!-- Campo oculto para el ID de la categoría -->
                                <input type="hidden" asp-for="id_categoria" />

                                <div class="mb-4">
                                    <label asp-for="nombre" class="form-label fw-bold">Nombre</label>
                                    <input asp-for="nombre" class="form-control" placeholder="Nombre de la categoría" />
                                    <span asp-validation-for="nombre" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="descripcion" class="form-label fw-bold">Descripción</label>
                                    <textarea asp-for="descripcion" class="form-control" style="height: 250px;"></textarea>
                                    <span asp-validation-for="descripcion" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="estado" class="form-label fw-bold">Estado</label>
                                    <select asp-for="estado" class="form-select">
                                        <option value="activo">Activo</option>
                                        <option value="inactivo">Inactivo</option>
                                    </select>
                                    <span asp-validation-for="estado" class="text-danger"></span>
                                </div>

                                <!-- Campo oculto para la fecha  -->
                                <input type="hidden" asp-for="fecha_creacion" />

                                <div class="d-flex justify-content-between mt-4">
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fa-solid fa-arrow-left me-1"></i> Volver
                                    </a>
                                    <button type="submit" class="btn btn-dark">
                                        <i class="fa-solid fa-save me-1"></i> Actualizar
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100 bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title border-bottom pb-2">
                                            <i class="fas fa-info-circle text-dark me-2"></i>Información
                                        </h5>
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-2">
                                                <i class="fas fa-check-circle text-dark me-2"></i>
                                                Actualice el nombre si necesita más precisión
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-check-circle text-dark me-2"></i>
                                                Revise la descripción para mantenerla actualizada
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-check-circle text-dark me-2"></i>
                                                Puede activar o desactivar la categoría según necesite
                                            </li>
                                            
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.3/tinymce.min.js"
            integrity="sha512-VCEWnpOl7PIhbYMcb64pqGZYez41C2uws/M/mDdGPy+vtEJHd9BqbShE4/VNnnZdr7YCPOjd+CBmYca/7WWWCw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        tinymce.init({
            selector: 'textarea',
            plugins: 'lists',
            menubar: 'file edit format',
            toolbar: 'undo redo | bold italic | bullist numlist',
            height: 250
        });
    </script>
}