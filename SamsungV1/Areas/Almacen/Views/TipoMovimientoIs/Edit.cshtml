@model Sistema.Models.TipoMovimientoI
@{
    ViewData["Title"] = "Editar Tipo de Movimiento";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="text-center mb-0"><i class="fa-solid fa-edit me-2"></i>Editar Tipo de Movimiento</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Campo oculto para el ID -->
                        <input type="hidden" asp-for="id_tipomovimiento" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-4">
                                    <label asp-for="nombre" class="form-label fw-bold">Nombre del Movimiento</label>
                                    <input asp-for="nombre" class="form-control" placeholder="Ej: Entrada por Compra, Salida por Venta..." />
                                    <span asp-validation-for="nombre" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="afecta_stock" class="form-label fw-bold">Afecta Stock</label>
                                    <div class="input-group">
                                        <select asp-for="afecta_stock" class="form-select">
                                            <option value="+">+ (Aumenta Stock)</option>
                                            <option value="-">- (Disminuye Stock)</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="afecta_stock" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="descripcion" class="form-label fw-bold">Descripción</label>
                                    <textarea asp-for="descripcion" class="form-control" style="height: 200px;" placeholder="Describa el propósito y uso de este tipo de movimiento..."></textarea>
                                    <span asp-validation-for="descripcion" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="estado" class="form-label fw-bold">Estado</label>
                                    <select asp-for="estado" class="form-select">
                                        <option value="activo">Activo</option>
                                        <option value="inactivo">Inactivo</option>
                                    </select>
                                    <span asp-validation-for="estado" class="text-danger"></span>
                                </div>

                                <div class="d-flex justify-content-between mt-4">
                                    <a asp-action="Index" class="btn btn-dark">
                                        <i class="fa-solid fa-arrow-left me-1"></i> Volver
                                    </a>
                                    <button type="submit" class="btn btn-secondary">
                                        <i class="fa-solid fa-save me-1"></i> Actualizar
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100 bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title border-bottom pb-2">
                                            <i class="fas fa-info-circle text-dark me-2"></i>Información
                                        </h5>

                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-lightbulb text-warning me-2"></i>Ejemplos de movimientos</h6>
                                            <ul class="small ps-3">
                                                <li><strong>Entrada (+):</strong> Compras, ajustes positivos, producción</li>
                                                <li><strong>Salida (-):</strong> Ventas, ajuste negativo, consumo interno</li>
                                            </ul>
                                        </div>

                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-check-circle text-dark me-2"></i>Consejos útiles</h6>
                                            <ul class="small ps-3">
                                                <li>Use nombres descriptivos y claros</li>
                                                <li>La descripción debe explicar cuándo se utiliza este tipo de movimiento</li>
                                                <li>Seleccione correctamente si aumenta o disminuye el stock</li>
                                                <li>Los tipos de movimiento son fundamentales para el seguimiento de inventario</li>
                                            </ul>
                                        </div>

                                        <div class="alert alert-info small">
                                            <i class="fas fa-exclamation-circle me-2"></i>
                                            Los tipos de movimiento definen cómo se modificará el inventario y son esenciales para mantener un control preciso del stock.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.3/tinymce.min.js"
            integrity="sha512-VCEWnpOl7PIhbYMcb64pqGZYez41C2uws/M/mDdGPy+vtEJHd9BqbShE4/VNnnZdr7YCPOjd+CBmYca/7WWWCw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        tinymce.init({
            selector: 'textarea',
            plugins: 'lists',
            menubar: 'file edit format',
            toolbar: 'undo redo | bold italic | bullist numlist',
            height: 200
        });
    </script>
}