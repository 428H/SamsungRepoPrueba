<div class="container mt-4">
	<div class="card shadow border-0 rounded-3 mb-4">
		<div class="card-header bg-gradient text-white" style="background-color: #212529;">
			<div class="d-flex justify-content-between align-items-center">
				<div>
					<h4 class="mb-0"><i class="fa-solid fa-users me-2"></i>LISTA DE CLIENTES</h4>
					<p class="text-white-50 mb-0 small">Gestione la información de clientes del sistema</p>
				</div>
				<div>
					<a asp-action="Create" class="text-black bg-body-tertiary btn btn-success">
						<i class="fa-solid fa-plus me-1"></i> Registrar Cliente
					</a>
				</div>
			</div>
		</div>
	</div>
	<table id="tblClientes" class="table table-striped table-bordered" style="width:100%">
		<thead>
			<tr>
				<th>DUI</th>
				<th>Nombre</th>
				<th>Apellido</th>
				<th>Telefono</th>
				<th>E-mail</th>
				<th>Acciones</th>
			</tr>
		</thead>
	</table>

</div>

@section Scripts {
	<script src="~/js/cliente.js"></script>
}
