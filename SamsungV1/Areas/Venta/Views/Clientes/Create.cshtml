@model Sistema.Models.Cliente
@{
    ViewData["Title"] = "Registrar Nuevo Cliente";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="text-center mb-0"><i class="fa-solid fa-user-plus me-2"></i>Registrar Nuevo Cliente</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-4">
                                    <label asp-for="dui" class="form-label fw-bold">DUI</label>
                                    <input asp-for="dui" class="form-control" placeholder="00000000-0" />
                                    <span asp-validation-for="dui" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="nombre" class="form-label fw-bold">Nombre</label>
                                    <input asp-for="nombre" class="form-control" placeholder="Ingrese nombre del cliente" />
                                    <span asp-validation-for="nombre" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="apellido" class="form-label fw-bold">Apellido</label>
                                    <input asp-for="apellido" class="form-control" placeholder="Ingrese apellido del cliente" />
                                    <span asp-validation-for="apellido" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="telefono" class="form-label fw-bold">Teléfono</label>
                                    <input asp-for="telefono" class="form-control" placeholder="6316-8635" />
                                    <span asp-validation-for="telefono" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="email" class="form-label fw-bold">Correo Electrónico</label>
                                    <input asp-for="email" class="form-control" placeholder="ejemplo@dominio.com" />
                                    <span asp-validation-for="email" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="estado" class="form-label fw-bold">Estado</label>
                                    <select asp-for="estado" class="form-select">
                                        <option value="activo">Activo</option>
                                        <option value="inactivo">Inactivo</option>
                                    </select>
                                    <span asp-validation-for="estado" class="text-danger"></span>
                                </div>

                                <input type="hidden" asp-for="fecha_registro" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" />

                                <div class="d-flex justify-content-between mt-4">
                                    <a asp-action="Index" class="btn btn-dark">
                                        <i class="fa-solid fa-arrow-left me-1"></i> Volver
                                    </a>
                                    <button type="submit" class="btn btn-secondary">
                                        <i class="fa-solid fa-save me-1"></i> Guardar
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100 bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title border-bottom pb-2">
                                            <i class="fas fa-info-circle text-dark me-2"></i>Información
                                        </h5>

                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-id-card text-warning me-2"></i>Formato DUI</h6>
                                            <p class="small">Ingrese el DUI con el formato correcto: 8 dígitos seguidos de un guion y el dígito verificador (00000000-0).</p>
                                        </div>

                                        <div class="mb-3">
                                            <h6 class="fw-bold"><i class="fas fa-check-circle text-dark me-2"></i>Consejos útiles</h6>
                                            <ul class="small ps-3">
                                                <li>Ingrese el nombre y apellido completo del cliente</li>
                                                <li>El formato de teléfono recomendado es XXXX-XXXX</li>
                                                <li>Asegúrese de ingresar un correo electrónico válido</li>
                                                <li>Por defecto, todos los clientes nuevos se registran como "Activos"</li>
                                            </ul>
                                        </div>

                                        <div class="alert alert-info small">
                                            <i class="fas fa-exclamation-circle me-2"></i>
                                            El registro adecuado de los clientes es esencial para mantener una base de datos precisa y facilitar las operaciones comerciales.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}