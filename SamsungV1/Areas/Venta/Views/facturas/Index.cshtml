@{
    ViewData["Title"] = "Facturas";
}
<div class="container mt-4">
    <div class="card shadow border-0 rounded-3 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #212529;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0"><i class="fa-solid fa-file-invoice me-2"></i>FACTURAS</h4>
                    <p class="text-white-50 mb-0 small">Administre las facturas del sistema</p>
                </div>
            </div>
        </div>
    </div>
    <table id="tblFacturas" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Número</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Productos</th>
                <th>Cantidades</th>
                <th>Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
    </table>
</div>
@section Scripts {
    <script src="~/js/factura.js"></script>
}