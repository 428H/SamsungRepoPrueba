@page
@using Sistema.Utilidades
@model RegisterModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-gradient text-white" style="background-color: #212529;">
                    <h3 class="text-center mb-0"><i class="fa-solid fa-user-plus me-2"></i>@ViewData["Title"]</h3>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-7">
                            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <h4 class="mb-3">Crear una nueva cuenta</h4>
                                <hr />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Nombre" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                    <label asp-for="Input.Nombre">Nombre</label>
                                    <span asp-validation-for="Input.Nombre" class="text-danger"></span>

                                </div>

                                <div class="mb-4">
                                    <label asp-for="Input.Email" class="form-label fw-bold">Email</label>
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Input.Password" class="form-label fw-bold">Contraseña</label>
                                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Contraseña" />
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Input.ConfirmPassword" class="form-label fw-bold">Confirmar Contraseña</label>
                                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar contraseña" />
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                                <div class="mb-4">
                                    <label for="roleSelect" class="form-label fw-bold">Rol</label>
                                    <select id="roleSelect" name="roleSelect" class="form-select" aria-required="true">
                                        <option value="" selected disabled>Selecciona un rol</option>
                                        <option value="@CNT.Admin">Administrador</option>
                                        <option value="@CNT.Almacen">Almacén</option>
                                        <option value="@CNT.Venta">Ventas</option>
                                    </select>
                                    <span class="text-danger" style="display:none;">Por favor selecciona un rol</span>
                                </div>

                                <div class="mb-4">
                                    <button id="registerSubmit" type="submit" class="btn btn-primary w-100">
                                        <i class="fa-solid fa-user-check me-2"></i>Registrarse
                                    </button>
                                </div>

                            </form>
                        </div>

                        <div class="col-md-5">
                            <div class="card h-100 bg-light">
                                <div class="card-body">
                                    <h5 class="card-title border-bottom pb-2">
                                        <i class="fas fa-info-circle text-dark me-2"></i>Información de Registro
                                    </h5>

                                    <ul class="list-unstyled mt-4">
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-dark me-2"></i>
                                            Utiliza un correo electrónico válido
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-dark me-2"></i>
                                            Tu contraseña debe ser segura y contener al menos 8 caracteres
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-dark me-2"></i>
                                            Asegúrate de confirmar correctamente tu contraseña
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-dark me-2"></i>
                                            Revisa tu email después de registrarte para activar tu cuenta
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-dark me-2"></i>
                                            Ya registrado podrás acceder a todas las funciones del sistema
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}