@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-gradient text-white" style="background-color: #212529;">
                    <h3 class="text-center mb-0"><i class="fa-solid fa-key me-2"></i>@ViewData["Title"]</h3>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-7">
                            <form method="post">
                                <h4 class="mb-3">Ingresa tu correo electrónico</h4>
                                <hr />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                                <div class="mb-4">
                                    <label asp-for="Input.Email" class="form-label fw-bold">Email</label>
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fa-solid fa-paper-plane me-2"></i>Enviar Enlace de Recuperación
                                    </button>
                                </div>

                                <div class="d-flex flex-column">
                                    <a asp-page="./Login" class="mb-2">
                                        <i class="fa-solid fa-arrow-left me-2"></i>Volver a inicio de sesión
                                    </a>
                                </div>
                            </form>
                        </div>

                        <div class="col-md-5">
                            <div class="card h-100 bg-light">
                                <div class="card-body">
                                    <h5 class="card-title border-bottom pb-2">
                                        <i class="fas fa-info-circle text-dark me-2"></i>Recuperación de Contraseña
                                    </h5>

                                    <ul class="list-unstyled mt-4">
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-dark me-2"></i>
                                            Ingresa el correo electrónico asociado a tu cuenta
                                        </li>
                                     
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-dark me-2"></i>
                                            El enlace de recuperación es válido por tiempo limitado
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-dark me-2"></i>
                                            Si no recibes el correo, verifica tu carpeta de spam
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}