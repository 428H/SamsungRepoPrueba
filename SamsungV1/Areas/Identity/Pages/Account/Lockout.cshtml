@page
@model LockoutModel
@{
    ViewData["Title"] = "Cuenta Bloqueada";
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="col-md-6 col-lg-4 text-center">
            <div class="mb-4">
                <i class="fas fa-user-lock fa-5x text-danger opacity-75"></i>
            </div>

            <h1 class="display-6 mb-3 text-danger">¡Cuenta Bloqueada!</h1>

            <p class="lead mb-4">
                Tu cuenta ha sido bloqueada temporalmente por razones de seguridad.
            </p>

            <p class="text-muted mb-4">
                Por favor, espera unos minutos antes de intentar iniciar sesión nuevamente o contacta al administrador si necesitas ayuda.
            </p>

            <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                <a href="/" class="text-black btn bg-primary-subtle btn-primary">
                    <i class="fas fa-home me-2"></i>Inicio
                </a>

                <a href="/Identity/Account/Login" class="btn btn-outline-secondary">
                    <i class="fas fa-redo me-2"></i>Reintentar
                </a>
            </div>
        </div>
    </div>
</div>