@* @model Microsoft.AspNetCore.Identity.IdentityUser *@
@using Sistema.Models
@model Sistema.Models.ApplicationUser
@{
    ViewData["Title"] = "Detalles de Usuario";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-3 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #212529;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0"><i class="fa-solid fa-user me-2"></i>DETALLE DE USUARIO</h4>
                    <p class="text-white-50 mb-0 small">Información del usuario @Model.UserName</p>
                </div>
                <div>
                    <a asp-action="Index" class="text-black bg-body-tertiary btn btn-light">
                        <i class="fa-solid fa-arrow-left me-1"></i> Volver a la Lista
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="fa-solid fa-address-card me-2"></i>Información Principal</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">Nombre</dt>
                                <dd class="col-sm-8 fw-bold">@Model.Nombre</dd>

                                <dt class="col-sm-4 text-muted">Nombre de Usuario</dt>
                                <dd class="col-sm-8 fw-bold">@Model.UserName</dd>

                                <dt class="col-sm-4 text-muted">Correo Electrónico</dt>
                                <dd class="col-sm-8">
                                    <span class="d-flex align-items-center">
                                        <i class="fa-solid fa-envelope me-2 text-secondary"></i>
                                        @Model.Email
                                    </span>
                                </dd>

                                <dt class="col-sm-4 text-muted">Email Confirmado</dt>
                                <dd class="col-sm-8">
                                    @if (Model.EmailConfirmed)
                                    {
                                        <span class=""><i class="fa-solid fa-check me-1"></i> Confirmado</span>
                                    }
                                    else
                                    {
                                        <span class=""><i class="fa-solid fa-times me-1"></i> No Confirmado</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 text-muted">Número de Teléfono</dt>
                                <dd class="col-sm-8">
                                    <span class="d-flex align-items-center">
                                        <i class="fa-solid fa-phone me-2 text-secondary"></i>
                                        @(string.IsNullOrEmpty(Model.PhoneNumber) ? "No disponible" : Model.PhoneNumber)
                                    </span>
                                </dd>

                                <dt class="col-sm-4 text-muted">Teléfono Confirmado</dt>
                                <dd class="col-sm-8">
                                    @if (Model.PhoneNumberConfirmed)
                                    {
                                        <span class=""><i class="fa-solid fa-check me-1"></i> Confirmado</span>
                                    }
                                    else
                                    {
                                        <span class=""><i class="fa-solid fa-times me-1"></i> No Confirmado</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="fa-solid fa-shield-alt me-2"></i>Seguridad</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">2FA Activado</dt>
                                <dd class="col-sm-8">
                                    @if (Model.TwoFactorEnabled)
                                    {
                                        <span class=""><i class="fa-solid fa-check me-1"></i> Activado</span>
                                    }
                                    else
                                    {
                                        <span class=""><i class="fa-solid fa-times me-1"></i> Desactivado</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 text-muted">Bloqueo Habilitado</dt>
                                <dd class="col-sm-8">
                                    @if (Model.LockoutEnabled)
                                    {
                                        <span class=""><i class="fa-solid fa-exclamation-triangle me-1"></i> Habilitado</span>
                                    }
                                    else
                                    {
                                        <span class=""><i class="fa-solid fa-times me-1"></i> Deshabilitado</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 text-muted">Estado de Bloqueo</dt>
                                <dd class="col-sm-8">
                                    @if (Model.LockoutEnd.HasValue && Model.LockoutEnd.Value > DateTimeOffset.Now)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fa-solid fa-lock me-1"></i>
                                            Bloqueado desde @Model.LockoutEnd.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class=""><i class="fa-solid fa-unlock me-1"></i> No bloqueado</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 text-muted">Intentos Fallidos</dt>
                                <dd class="col-sm-8">
                                    @if (Model.AccessFailedCount > 0)
                                    {
                                        <span class="badge bg-danger"><i class="fa-solid fa-exclamation-circle me-1"></i> @Model.AccessFailedCount</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check-circle me-1"></i> 0</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Volver a la Lista
                </a>

                <div>

                    @if (Model.LockoutEnd.HasValue && Model.LockoutEnd.Value > DateTimeOffset.Now)
                    {
                        <form asp-action="Desbloquear" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success" onclick="return confirm('¿Estás seguro de que deseas desbloquear este usuario?');">
                                <i class="fa-solid fa-unlock me-1"></i> Desbloquear Usuario
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Bloquear" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Estás seguro de que deseas bloquear este usuario?');">
                                <i class="fa-solid fa-lock me-1"></i> Bloquear Usuario
                            </button>
                        </form>
                    }
                </div>

            </div>
        </div>
    </div>
</div>