@{
    ViewData["Title"] = "Lista de Usuarios";
}

<div class="container mt-4">

    <div class="card shadow border-0 rounded-3 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #212529;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0"><i class="fa-solid fa-users me-2"></i>LISTA DE USUARIOS</h4>
                    <p class="text-white-50 mb-0 small">Administre los usuarios del sistema</p>
                </div>
                <div>
                   
                    <a asp-area="Identity" asp-page="/Account/Register" class="text-black bg-body-tertiary btn btn-success">
                        <i class="fa-solid fa-plus me-1"></i> Crear Usuario
                    </a>
                  
                </div>
            </div>
        </div>
    </div>

    <table id="tblUsuarios" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Nombre de Usuario</th>
                <th>Email</th>
                <th>Email Confirmado</th>
                <th>Teléfono</th>
                <th>2FA</th>
                <th>Bloqueado</th>
                <th>Acciones</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/usuario.js"></script>
}